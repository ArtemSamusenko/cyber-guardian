# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/cybersec_game
DB_POOL_MIN_SIZE=10
DB_POOL_MAX_SIZE=20

# Security
# Required. The API refuses to start while this is still the placeholder.
# Generate a real key with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-this-to-a-secure-random-key-at-least-32-characters-long
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Application
ENV=development
DEBUG=False
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
